<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             x:DataType="vm:LoginViewModel"
             x:Class="Tienda.Views.RegisterPage"
             BackgroundColor="#111111"
             NavigationPage.HasNavigationBar="False"
             Title="Registrar">

	<ScrollView>
		<VerticalStackLayout Padding="32,60,32,40" Spacing="0">

			<Label Text="REGÍSTRATE"
                   TextColor="White"
                   FontSize="34"
                   FontAttributes="Bold"
                   CharacterSpacing="3"
                   HorizontalOptions="Start" />

			<Label Text="Crea tu cuenta THE DROP"
                   TextColor="#CCFF00"
                   FontSize="11"
                   CharacterSpacing="4"
                   Margin="0,4,0,52" />

			<!-- Name -->
			<Label Text="NOMBRE COMPLETO"
                   TextColor="#555555"
                   FontSize="10"
                   CharacterSpacing="1.5"
                   Margin="0,0,0,6" />
			<Border BackgroundColor="#1A1A1A"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    Stroke="#2E2E2E"
                    Padding="16,14"
                    Margin="0,0,0,14">
				<Entry Text="{Binding Name}"
                       Placeholder="Juan Pérez"
                       PlaceholderColor="#444"
                       TextColor="White"
                       BackgroundColor="Transparent" />
			</Border>

			<!-- Email -->
			<Label Text="CORREO ELECTRÓNICO"
                   TextColor="#555555"
                   FontSize="10"
                   CharacterSpacing="1.5"
                   Margin="0,0,0,6" />
			<Border BackgroundColor="#1A1A1A"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    Stroke="#2E2E2E"
                    Padding="16,14"
                    Margin="0,0,0,14">
				<Entry Text="{Binding Email}"
                       Placeholder="usuario@mail.com"
                       PlaceholderColor="#444"
                       TextColor="White"
                       Keyboard="Email"
                       BackgroundColor="Transparent" />
			</Border>

			<!-- Password -->
			<Label Text="CONTRASEÑA"
                   TextColor="#555555"
                   FontSize="10"
                   CharacterSpacing="1.5"
                   Margin="0,0,0,6" />
			<Border BackgroundColor="#1A1A1A"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    Stroke="#2E2E2E"
                    Padding="16,14"
                    Margin="0,0,0,8">
				<Entry Text="{Binding Password}"
                       IsPassword="True"
                       Placeholder="Mínimo 6 caracteres"
                       PlaceholderColor="#444"
                       TextColor="White"
                       BackgroundColor="Transparent" />
			</Border>

			
			<HorizontalStackLayout Spacing="8" Margin="0,12,0,24">
			
				<CheckBox IsChecked="True"
                          Color="#CCFF00"
                          VerticalOptions="Center" />
				<Label Text="Acepto los Términos y Políticas de Privacidad"
                       TextColor="White"
                       FontSize="12"
                       VerticalOptions="Center" />
			</HorizontalStackLayout>

			<!-- Register Button -->
			<Border BackgroundColor="#CCFF00"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    Padding="0,16"
                    Margin="0,0,0,12">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding RegisterCommand}" />
				</Border.GestureRecognizers>
				<Label Text="CREAR CUENTA"
                       TextColor="#111111"
                       FontSize="14"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       HorizontalOptions="Center" />
			</Border>

			<!-- Back -->
			<Label Text="¿Ya tienes cuenta?"
                   TextColor="#444444"
                   FontSize="12"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0">
				<Label.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
				</Label.GestureRecognizers>
			</Label>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>