<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             x:DataType="vm:LoginViewModel"
             x:Class="Tienda.Views.RegisterPage"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False"
             Title="Registrar">

    <ScrollView>
        <VerticalStackLayout Padding="28,64,28,40" Spacing="0">

            <!-- Branding -->
            <BoxView Color="#CCFF00" HeightRequest="3" WidthRequest="32"
                     HorizontalOptions="Start" Margin="0,0,0,20" />

            <Label Text="REGÍSTRATE"
                   TextColor="White"
                   FontSize="36"
                   FontAttributes="Bold"
                   CharacterSpacing="3"
                   HorizontalOptions="Start" />

            <Label Text="CREA TU CUENTA · THE DROP"
                   TextColor="#3A3A3A"
                   FontSize="10"
                   FontAttributes="Bold"
                   CharacterSpacing="3"
                   Margin="0,6,0,48" />

            <!-- Nombre -->
            <Label Text="NOMBRE COMPLETO"
                   TextColor="#3A3A3A"
                   FontSize="9"
                   FontAttributes="Bold"
                   CharacterSpacing="2.5"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="#111111"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1"
                    Stroke="#222222"
                    Padding="16,0"
                    Margin="0,0,0,16">
                <Entry Text="{Binding Name}"
                       Placeholder="Juan Pérez"
                       PlaceholderColor="#303030"
                       TextColor="White"
                       FontSize="14"
                       BackgroundColor="Transparent"
                       HeightRequest="50" />
            </Border>

            <!-- Email -->
            <Label Text="CORREO ELECTRÓNICO"
                   TextColor="#3A3A3A"
                   FontSize="9"
                   FontAttributes="Bold"
                   CharacterSpacing="2.5"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="#111111"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1"
                    Stroke="#222222"
                    Padding="16,0"
                    Margin="0,0,0,16">
                <Entry Text="{Binding Email}"
                       Placeholder="usuario@mail.com"
                       PlaceholderColor="#303030"
                       TextColor="White"
                       FontSize="14"
                       Keyboard="Email"
                       BackgroundColor="Transparent"
                       HeightRequest="50" />
            </Border>

            <!-- Password -->
            <Label Text="CONTRASEÑA"
                   TextColor="#3A3A3A"
                   FontSize="9"
                   FontAttributes="Bold"
                   CharacterSpacing="2.5"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="#111111"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1"
                    Stroke="#222222"
                    Padding="16,0"
                    Margin="0,0,0,20">
                <Entry Text="{Binding Password}"
                       IsPassword="True"
                       Placeholder="6-12 caracteres"
                       PlaceholderColor="#303030"
                       TextColor="White"
                       FontSize="14"
                       BackgroundColor="Transparent"
                       HeightRequest="50" />
            </Border>

            <!-- Requisitos de contraseña -->
            <VerticalStackLayout Spacing="3" Margin="0,-12,0,20">
                <Label Text="• 6 a 12 caracteres"
                       TextColor="#505050" FontSize="11" />
                <Label Text="• Al menos una mayúscula y una minúscula"
                       TextColor="#505050" FontSize="11" />
                <Label Text="• Al menos un número y un signo (!@#$%...)"
                       TextColor="#505050" FontSize="11" />
            </VerticalStackLayout>

            <!-- Terms -->
            <HorizontalStackLayout Spacing="10" Margin="0,0,0,28">
                <CheckBox IsChecked="True" Color="#CCFF00" VerticalOptions="Center" />
                <Label Text="Acepto los Términos y Políticas de Privacidad"
                       TextColor="#505050"
                       FontSize="12"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Error -->
            <Border BackgroundColor="#1A0000"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    Stroke="#3A0000"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmptyConverter}}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#FF3E00"
                       FontSize="12" />
            </Border>

            <!-- Crear cuenta Button -->
            <Border BackgroundColor="#CCFF00"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="0"
                    Margin="0,0,0,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RegisterCommand}" />
                </Border.GestureRecognizers>
                <Grid HeightRequest="52">
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="#0D0D0D"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                    <Label Text="CREAR CUENTA"
                           TextColor="#0D0D0D"
                           FontSize="14"
                           FontAttributes="Bold"
                           CharacterSpacing="2.5"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}" />
                </Grid>
            </Border>

            <!-- Back to login -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,16,0,0">
                <Label Text="¿Ya tienes cuenta?" TextColor="#303030" FontSize="12" />
                <Label Text="INICIAR SESIÓN"
                       TextColor="#CCFF00"
                       FontSize="12"
                       FontAttributes="Bold"
                       CharacterSpacing="1">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
