<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             x:DataType="vm:AccountViewModel"
             x:Class="Tienda.Views.AccountPage"
             BackgroundColor="#111111"
             NavigationPage.HasNavigationBar="False"
             Title="PERFIL">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Cover con patrón -->
            <Grid HeightRequest="110" BackgroundColor="#1A1A1A">
                <BoxView Color="#CCFF00" Opacity="0.06" />
            </Grid>

            <!-- Avatar centrado sobre el cover -->
            <Border WidthRequest="76"
                    HeightRequest="76"
                    StrokeShape="RoundRectangle 38"
                    BackgroundColor="#222222"
                    Stroke="#CCFF00"
                    StrokeThickness="3"
                    HorizontalOptions="Center"
                    Margin="0,-38,0,0">
                <Label Text="{Binding AvatarInitials}"
                       TextColor="#CCFF00"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Nombre y nivel -->
            <Label Text="{Binding UserName}"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   CharacterSpacing="2"
                   HorizontalOptions="Center"
                   Margin="0,12,0,4" />
            <Label Text="{Binding UserLevel}"
                   TextColor="#CCFF00"
                   FontSize="10"
                   CharacterSpacing="3"
                   HorizontalOptions="Center"
                   Margin="0,0,0,22" />

            <!-- Stats -->
            <Border BackgroundColor="#1E1E1E"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    Margin="20,0,20,24">
                <Grid ColumnDefinitions="*, *, *">
                    <VerticalStackLayout Grid.Column="0" Padding="8,16" HorizontalOptions="Center">
                        <Label Text="{Binding TotalOrders}"
                               TextColor="#CCFF00"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="PEDIDOS"
                               TextColor="#555555"
                               FontSize="9"
                               CharacterSpacing="1.5"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <BoxView Grid.Column="0" Color="#2A2A2A" WidthRequest="1" HorizontalOptions="End" VerticalOptions="Fill" />
                    <VerticalStackLayout Grid.Column="1" Padding="8,16" HorizontalOptions="Center">
                        <Label Text="{Binding TotalSpent, StringFormat='${0:F0}'}"
                               TextColor="#CCFF00"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="GASTADO"
                               TextColor="#555555"
                               FontSize="9"
                               CharacterSpacing="1.5"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <BoxView Grid.Column="1" Color="#2A2A2A" WidthRequest="1" HorizontalOptions="End" VerticalOptions="Fill" />
                    <VerticalStackLayout Grid.Column="2" Padding="8,16" HorizontalOptions="Center">
                        <Label Text="{Binding DropsParticipated}"
                               TextColor="#CCFF00"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="DROPS"
                               TextColor="#555555"
                               FontSize="9"
                               CharacterSpacing="1.5"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Menú -->
            <VerticalStackLayout Padding="20,0" Spacing="8">

                <Border BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToOrderHistoryCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="#1ACCFF00" StrokeShape="RoundRectangle 8" StrokeThickness="0" WidthRequest="34" HeightRequest="34">
                            <Label Text="📦" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Historial de compras" TextColor="White" FontSize="13" FontAttributes="Bold" />
                            <Label Text="12 pedidos completados" TextColor="#555555" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#555555" FontSize="20" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAddressesCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="#1ACCFF00" StrokeShape="RoundRectangle 8" StrokeThickness="0" WidthRequest="34" HeightRequest="34">
                            <Label Text="📍" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Mis direcciones" TextColor="White" FontSize="13" FontAttributes="Bold" />
                            <Label Text="2 direcciones guardadas" TextColor="#555555" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#555555" FontSize="20" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="#1ACCFF00" StrokeShape="RoundRectangle 8" StrokeThickness="0" WidthRequest="34" HeightRequest="34">
                            <Label Text="🔔" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Notificaciones de drops" TextColor="White" FontSize="13" FontAttributes="Bold" />
                            <Label Text="Activadas" TextColor="#CCFF00" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#555555" FontSize="20" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Cerrar sesión -->
                <Border BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1"
                        Stroke="#FF3E00"
                        Padding="16,14"
                        Margin="0,8,0,16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="CERRAR SESIÓN"
                           TextColor="#FF3E00"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           HorizontalOptions="Center" />
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>