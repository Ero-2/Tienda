<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             xmlns:svc="clr-namespace:Tienda.Services"
             x:DataType="vm:AccountViewModel"
             x:Class="Tienda.Views.AccountPage"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False"
             Title="PERFIL">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header section con color block -->
            <Grid HeightRequest="130" BackgroundColor="#111111">
                <!-- Pattern sutil -->
                <BoxView Color="#CCFF00" Opacity="0.03" />
                <!-- Línea accent top -->
                <BoxView Color="#CCFF00" HeightRequest="3" VerticalOptions="Start" />
                <!-- Brand label -->
                <Label Text="THE DROP"
                       TextColor="#CCFF00"
                       FontSize="10"
                       FontAttributes="Bold"
                       CharacterSpacing="4"
                       Opacity="0.3"
                       HorizontalOptions="End"
                       VerticalOptions="End"
                       Margin="0,0,20,16" />
            </Grid>

            <!-- Avatar -->
            <Border WidthRequest="80"
                    HeightRequest="80"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#1C1C1C"
                    Stroke="#CCFF00"
                    StrokeThickness="2"
                    HorizontalOptions="Center"
                    Margin="0,-40,0,0">
                <Label Text="{Binding AvatarInitials}"
                       TextColor="#CCFF00"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Nombre -->
            <Label Text="{Binding UserName}"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   CharacterSpacing="2"
                   HorizontalOptions="Center"
                   Margin="0,14,0,4" />
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,0,0,28">
                <BoxView Color="#CCFF00" WidthRequest="4" HeightRequest="4"
                         VerticalOptions="Center" Rotation="45" />
                <Label Text="{Binding UserLevel}"
                       TextColor="#CCFF00"
                       FontSize="10"
                       FontAttributes="Bold"
                       CharacterSpacing="3" />
                <BoxView Color="#CCFF00" WidthRequest="4" HeightRequest="4"
                         VerticalOptions="Center" Rotation="45" />
            </HorizontalStackLayout>

            <!-- Stats -->
            <Border BackgroundColor="#111111"
                    StrokeShape="RoundRectangle 0"
                    StrokeThickness="1"
                    Stroke="#1A1A1A"
                    Margin="0,0,0,28">
                <Grid ColumnDefinitions="*, 1, *, 1, *">

                    <VerticalStackLayout Grid.Column="0" Padding="10,20" HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding TotalOrders}"
                               TextColor="#CCFF00"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="PEDIDOS"
                               TextColor="#404040"
                               FontSize="9"
                               FontAttributes="Bold"
                               CharacterSpacing="2"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <BoxView Grid.Column="1" Color="#1A1A1A" />

                    <VerticalStackLayout Grid.Column="2" Padding="10,20" HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding TotalSpent, StringFormat='${0:F0}'}"
                               TextColor="#CCFF00"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="GASTADO"
                               TextColor="#404040"
                               FontSize="9"
                               FontAttributes="Bold"
                               CharacterSpacing="2"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <BoxView Grid.Column="3" Color="#1A1A1A" />

                    <VerticalStackLayout Grid.Column="4" Padding="10,20" HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding DropsParticipated}"
                               TextColor="#CCFF00"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="DROPS"
                               TextColor="#404040"
                               FontSize="9"
                               FontAttributes="Bold"
                               CharacterSpacing="2"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- Crédito disponible -->
            <Border BackgroundColor="#0D1A00"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="#CCFF0033"
                    Padding="20,16"
                    Margin="20,0,20,12">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="CRÉDITO DISPONIBLE"
                                   TextColor="#CCFF00" FontSize="9"
                                   FontAttributes="Bold" CharacterSpacing="2.5" />
                            <Label Text="{Binding CreditoDisponible, StringFormat='${0:F2}'}"
                                   TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Text="{Binding LimiteCredito, StringFormat='Límite: ${0:F0}'}"
                                   TextColor="#404040" FontSize="10"
                                   HorizontalOptions="End" />
                            <Label Text="{Binding CreditoUsado, StringFormat='Usado: ${0:F2}'}"
                                   TextColor="#606060" FontSize="10"
                                   HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>
                    <!-- Barra disponible / límite -->
                    <ProgressBar Progress="{Binding CreditoPorcentaje}"
                                 ProgressColor="#CCFF00"
                                 BackgroundColor="#1A2A00"
                                 HeightRequest="4" />
                </VerticalStackLayout>
            </Border>

            <!-- Planes de pago activos (MSI) -->
            <VerticalStackLayout Padding="20,0,20,16"
                                 IsVisible="{Binding TienePlanes}">
                <Label Text="PAGOS A MESES"
                       TextColor="#3A3A3A" FontSize="9"
                       FontAttributes="Bold" CharacterSpacing="2.5"
                       Margin="0,0,0,8" />
                <CollectionView ItemsSource="{Binding PlanesActivos}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="svc:PlanPagoInfo">
                            <Border BackgroundColor="#111111"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1"
                                    Stroke="#1E1E1E"
                                    Padding="16,12"
                                    Margin="0,0,0,6">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding MesesMsi, StringFormat='{0} MSI'}"
                                               TextColor="#CCFF00" FontSize="10"
                                               FontAttributes="Bold" CharacterSpacing="1" />
                                        <Label Text="{Binding CuotaMensual, StringFormat='${0:F2}/mes'}"
                                               TextColor="White" FontSize="15" FontAttributes="Bold" />
                                        <Label TextColor="#404040" FontSize="10">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0}/{1} cuotas pagadas">
                                                    <Binding Path="CuotasPagadas" />
                                                    <Binding Path="MesesMsi" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            BackgroundColor="#CCFF00"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="0"
                                            Padding="12,8"
                                            VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PagarCuotaCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="PAGAR" TextColor="#0D0D0D"
                                               FontSize="10" FontAttributes="Bold"
                                               CharacterSpacing="1" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Menú -->
            <VerticalStackLayout Padding="20,0" Spacing="2">

                <!-- Historial -->
                <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 0"
                        StrokeThickness="0" Padding="18,16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToOrderHistoryCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                        <BoxView Grid.Column="0" Color="#CCFF00" WidthRequest="3" HeightRequest="28"
                                 VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="HISTORIAL DE COMPRAS"
                                   TextColor="White" FontSize="13" FontAttributes="Bold"
                                   CharacterSpacing="0.5" />
                            <Label Text="{Binding TotalOrders, StringFormat='{0} pedidos completados'}"
                                   TextColor="#404040" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#404040" FontSize="22"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <BoxView Color="#151515" HeightRequest="1" />

                <!-- Direcciones -->
                <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 0"
                        StrokeThickness="0" Padding="18,16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAddressesCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                        <BoxView Grid.Column="0" Color="#CCFF00" WidthRequest="3" HeightRequest="28"
                                 VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="MIS DIRECCIONES"
                                   TextColor="White" FontSize="13" FontAttributes="Bold"
                                   CharacterSpacing="0.5" />
                            <Label Text="{Binding AddressCount, StringFormat='{0} direcciones guardadas'}"
                                   TextColor="#404040" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#404040" FontSize="22"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <BoxView Color="#151515" HeightRequest="1" />

                <!-- Notificaciones -->
                <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 0"
                        StrokeThickness="0" Padding="18,16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                        <BoxView Grid.Column="0" Color="#CCFF00" WidthRequest="3" HeightRequest="28"
                                 VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="NOTIFICACIONES"
                                   TextColor="White" FontSize="13" FontAttributes="Bold"
                                   CharacterSpacing="0.5" />
                            <Label Text="Activadas" TextColor="#CCFF00" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#404040" FontSize="22"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Logout -->
                <Border BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        Stroke="#2A0000"
                        Padding="18,14"
                        Margin="0,28,0,20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="CERRAR SESIÓN"
                           TextColor="#FF3E00"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           HorizontalOptions="Center" />
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
