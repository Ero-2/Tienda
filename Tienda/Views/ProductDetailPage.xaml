<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             x:DataType="vm:ProductDetailViewModel"
             x:Class="Tienda.Views.ProductDetailPage"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <Grid RowDefinitions="300, *">

            <!-- Hero imagen con gradient -->
            <Grid Grid.Row="0" HeightRequest="300">
                <Image Source="{Binding Product.ImageUrl}"
                       Aspect="AspectFill"
                       HeightRequest="300" />

                <!-- Gradient overlay bottom -->
                <BoxView HeightRequest="130" VerticalOptions="End">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#000D0D0D" Offset="0" />
                            <GradientStop Color="#FF0D0D0D" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <!-- Botón regresar -->
                <Border BackgroundColor="#CC111111"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        WidthRequest="40" HeightRequest="40"
                        Margin="16,52,0,0"
                        VerticalOptions="Start"
                        HorizontalOptions="Start">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="←" TextColor="White" FontSize="18"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Favorito -->
                <Border BackgroundColor="#CC111111"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        WidthRequest="40" HeightRequest="40"
                        Margin="0,52,16,0"
                        VerticalOptions="Start"
                        HorizontalOptions="End">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Brand + badge sobre el gradient -->
                <HorizontalStackLayout VerticalOptions="End" Margin="20,0,20,18" Spacing="10">
                    <Label Text="{Binding Product.Brand}"
                           TextColor="#CCFF00"
                           FontSize="9"
                           FontAttributes="Bold"
                           CharacterSpacing="3"
                           VerticalOptions="Center" />
                    <Border BackgroundColor="#CCFF00"
                            StrokeShape="RoundRectangle 4"
                            StrokeThickness="0"
                            Padding="6,2"
                            IsVisible="{Binding Product.IsNew}">
                        <Label Text="NEW" TextColor="#0D0D0D" FontSize="8"
                               FontAttributes="Bold" CharacterSpacing="1.5" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- Info -->
            <VerticalStackLayout Grid.Row="1" Padding="20,16,20,32" Spacing="0">

                <!-- Nombre -->
                <Label Text="{Binding Product.Name}"
                       TextColor="White"
                       FontSize="24"
                       FontAttributes="Bold"
                       LineBreakMode="WordWrap"
                       LineHeight="1.2"
                       Margin="0,0,0,10" />

                <!-- Precio -->
                <Label Text="{Binding Product.Price, StringFormat='${0:F2}'}"
                       TextColor="#CCFF00"
                       FontSize="30"
                       FontAttributes="Bold"
                       Margin="0,0,0,24" />

                <!-- Divider -->
                <BoxView Color="#1E1E1E" HeightRequest="1" Margin="0,0,0,20" />

                <!-- Tallas -->
                <Label Text="TALLA"
                       TextColor="#505050"
                       FontSize="9"
                       FontAttributes="Bold"
                       CharacterSpacing="2.5"
                       Margin="0,0,0,10" />

                <CollectionView ItemsSource="{Binding AvailableSizes}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedSize}"
                                HeightRequest="48"
                                Margin="0,0,0,24">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border BackgroundColor="#141414"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="1"
                                    Stroke="#252525"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Padding="0">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#141414" />
                                                    <Setter Property="Stroke" Value="#252525" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#CCFF00" />
                                                    <Setter Property="Stroke" Value="#CCFF00" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <Label Text="{Binding .}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="TextColor" Value="#666666" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="TextColor" Value="#0D0D0D" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Divider -->
                <BoxView Color="#1E1E1E" HeightRequest="1" Margin="0,0,0,20" />

                <!-- Descripción -->
                <Label Text="{Binding Product.Description}"
                       TextColor="#666666"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       LineHeight="1.7"
                       Margin="0,0,0,20" />

                <!-- Stock -->
                <HorizontalStackLayout Spacing="8" Margin="0,0,0,28">
                    <BoxView Color="#CCFF00" WidthRequest="6" HeightRequest="6"
                             VerticalOptions="Center"
                             Rotation="45" />
                    <Label Text="EN STOCK · DISPONIBLE"
                           TextColor="#CCFF00"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Add to cart -->
                <Border BackgroundColor="#CCFF00"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        Padding="0,18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddToCartCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="+ AGREGAR AL CARRITO"
                           TextColor="#0D0D0D"
                           FontSize="14"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           HorizontalOptions="Center" />
                </Border>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
