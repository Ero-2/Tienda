<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Tienda.ViewModels"
             xmlns:models="clr-namespace:Tienda.Models"
             x:DataType="viewModels:ProductsViewModel"
             x:Class="Tienda.Views.ProductsPage"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False"
             Title="THE DROP">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" BackgroundColor="#0D0D0D">

        <!-- Top bar -->
        <Grid Grid.Row="0" Padding="20,16,16,12" ColumnDefinitions="*, Auto, Auto">
            <Label Grid.Column="0"
                   Text="THE DROP"
                   TextColor="White"
                   FontSize="22"
                   FontAttributes="Bold"
                   CharacterSpacing="3"
                   VerticalOptions="Center" />

            <Border Grid.Column="1"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    WidthRequest="44" HeightRequest="44"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToAccountCommand}" />
                </Border.GestureRecognizers>
                <Label Text="☰" TextColor="White" FontSize="20"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                <Border BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="44" HeightRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToCartCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="🛒" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Border BackgroundColor="#CCFF00"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        WidthRequest="16" HeightRequest="16"
                        HorizontalOptions="End" VerticalOptions="Start"
                        Margin="0,4,2,0"
                        IsVisible="{Binding CartItemCount, Converter={StaticResource NotEmptyConverter}}">
                    <Label Text="{Binding CartItemCount}"
                           TextColor="#0D0D0D"
                           FontSize="9"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- Search -->
        <Border Grid.Row="1"
                BackgroundColor="#151515"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1"
                Stroke="#252525"
                Margin="16,0,16,10"
                Padding="14,0">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                <Label Grid.Column="0" Text="/" TextColor="#444" FontSize="14"
                       FontAttributes="Bold" CharacterSpacing="1" VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding SearchQuery}"
                       Placeholder="BUSCAR"
                       PlaceholderColor="#3A3A3A"
                       TextColor="White"
                       FontSize="13"
                       FontAttributes="Bold"
                       BackgroundColor="Transparent"
                       HeightRequest="44" />
            </Grid>
        </Border>

        <!-- Categorías -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Filters}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedFilter}"
                        HeightRequest="38"
                        Margin="12,0,12,12">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border StrokeShape="RoundRectangle 20"
                            StrokeThickness="1"
                            BackgroundColor="Transparent"
                            Stroke="#2A2A2A"
                            Padding="14,6">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter Property="Stroke" Value="#2A2A2A" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#CCFF00" />
                                            <Setter Property="Stroke" Value="#CCFF00" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                        <Label Text="{Binding .}" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="TextColor" Value="#555555" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="TextColor" Value="#0D0D0D" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                        </Label>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Productos -->
        <RefreshView Grid.Row="3"
                     Command="{Binding LoadProductsCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="#CCFF00">
            <CollectionView ItemsSource="{Binding Products}"
                            Margin="12,0,12,4">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                         Spacing="10" Margin="0,60,0,0">
                        <Label Text="—" TextColor="#CCFF00" FontSize="28" FontAttributes="Bold"
                               HorizontalOptions="Center" CharacterSpacing="4" />
                        <Label Text="SIN RESULTADOS"
                               TextColor="#444"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="2.5"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <Border StrokeThickness="1"
                                Stroke="#1E1E1E"
                                BackgroundColor="#141414"
                                StrokeShape="RoundRectangle 8"
                                Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ProductsViewModel}}, Path=ProductTappedCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="175, Auto" RowSpacing="0">

                                <!-- Imagen -->
                                <Grid Grid.Row="0">
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           HeightRequest="175" />

                                    <!-- Badge NEW -->
                                    <Border BackgroundColor="#CCFF00"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="0"
                                            Padding="6,3"
                                            Margin="8,8,0,0"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start"
                                            IsVisible="{Binding IsNew}">
                                        <Label Text="NEW" TextColor="#0D0D0D" FontSize="8"
                                               FontAttributes="Bold" CharacterSpacing="1.5" />
                                    </Border>

                                    <!-- Badge HOT -->
                                    <Border BackgroundColor="#FF3E00"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="0"
                                            Padding="6,3"
                                            Margin="8,8,0,0"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start"
                                            IsVisible="{Binding IsHot}">
                                        <Label Text="HOT" TextColor="White" FontSize="8"
                                               FontAttributes="Bold" CharacterSpacing="1.5" />
                                    </Border>
                                </Grid>

                                <!-- Info -->
                                <VerticalStackLayout Grid.Row="1" Padding="10,10,10,12" Spacing="2">
                                    <Label Text="{Binding Brand}"
                                           TextColor="#CCFF00"
                                           FontSize="9"
                                           CharacterSpacing="2.5" />
                                    <Label Text="{Binding Name}"
                                           TextColor="White"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"
                                           LineHeight="1.3" />
                                    <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                           TextColor="#CCFF00"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           Margin="0,4,0,0" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Paginación -->
        <Grid Grid.Row="4"
              BackgroundColor="#0D0D0D"
              Padding="20,10,20,14"
              ColumnDefinitions="44, *, 44">

            <Border Grid.Column="0"
                    BackgroundColor="#151515"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    Stroke="#252525"
                    WidthRequest="44" HeightRequest="44"
                    Opacity="{Binding HasPrevPage, Converter={StaticResource BoolToOpacityConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PrevPageCommand}" />
                </Border.GestureRecognizers>
                <Label Text="←" TextColor="White" FontSize="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                <Label Text="{Binding PageLabel}"
                       TextColor="#888888"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       HorizontalOptions="Center" />
                <BoxView Color="#CCFF00" HeightRequest="2" WidthRequest="24" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border Grid.Column="2"
                    BackgroundColor="#151515"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    Stroke="#252525"
                    WidthRequest="44" HeightRequest="44"
                    Opacity="{Binding HasNextPage, Converter={StaticResource BoolToOpacityConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NextPageCommand}" />
                </Border.GestureRecognizers>
                <Label Text="→" TextColor="White" FontSize="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

        </Grid>

    </Grid>
</ContentPage>
