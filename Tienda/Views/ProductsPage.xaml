<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             x:Class="Tienda.Views.ProductsPage"
             BackgroundColor="Black"
             Title="THE DROP">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cuenta" 
                     IconImageSource="dots_icon.png" 
                     Command="{Binding GoToAccountCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadProductsCommand}">
        <Grid RowDefinitions="Auto, *">

            <VerticalStackLayout Padding="20,10">
                <Label Text="NUEVA COLECCIÓN" FontSize="34" FontAttributes="Bold" TextColor="White" CharacterSpacing="2" />
                <BoxView HeightRequest="4" Color="#CCFF00" WidthRequest="60" HorizontalOptions="Start" Margin="0,5" />
            </VerticalStackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Products}" Margin="10">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="15" HorizontalItemSpacing="15" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto, Auto, Auto" Padding="5">
                            <Frame BackgroundColor="#111111" CornerRadius="0" Padding="0" HasShadow="False" HeightRequest="220">
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                            </Frame>
                            <Label Grid.Row="1" Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="14" Margin="0,8,0,0"/>
                            <Label Grid.Row="2" Text="{Binding Price, StringFormat='${0}'}" TextColor="#CCFF00" FontSize="16" FontAttributes="Bold" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </RefreshView>
</ContentPage>