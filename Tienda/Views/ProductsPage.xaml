<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Tienda.ViewModels"
             xmlns:models="clr-namespace:Tienda.Models"
             x:DataType="viewModels:ProductsViewModel"
             x:Class="Tienda.Views.ProductsPage"
             BackgroundColor="#121212"
             NavigationPage.HasNavigationBar="False"
             Title="THE DROP">

    <!-- Barra de 3 puntos personalizada -->
    <RefreshView IsRefreshing="{Binding IsRefreshing}" 
                 Command="{Binding LoadProductsCommand}"
                 RefreshColor="#CCFF00">
        <Grid RowDefinitions="Auto, Auto, *"
              Padding="0,0,0,0"
              RowSpacing="0">

            <!-- Cabecera principal con logo y menú de 3 puntos -->
            <Grid Grid.Row="0"
                  Padding="20,12"
                  ColumnDefinitions="Auto, *, Auto"
                  BackgroundColor="#121212">
                <Label Grid.Column="0"
                       Text="THE DROP"
                       TextColor="White"
                       FontSize="24"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       VerticalOptions="Center" />

                <!-- Botón de tres puntos para acceder a la cuenta -->
                <ImageButton Grid.Column="2"
                             Command="{Binding GoToAccountCommand}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             BackgroundColor="Transparent"
                             WidthRequest="44"
                             HeightRequest="44">
                    <ImageButton.Source>
                        <FontImageSource Glyph="⋮"
                                         FontFamily="Segoe UI Symbol"
                                         Size="28"
                                         Color="White" />
                    </ImageButton.Source>
                </ImageButton>
            </Grid>

            <!-- Título de sección NUEVA OLA -->
            <VerticalStackLayout Grid.Row="1"
                                 Padding="20,8,20,16"
                                 Spacing="4">
                <Label Text="NUEVA OLA"
                       TextColor="White"
                       FontSize="32"
                       FontAttributes="Bold"
                       CharacterSpacing="1.8" />
                <BoxView HeightRequest="3"
                         WidthRequest="70"
                         Color="#CCFF00"
                         HorizontalOptions="Start" />
            </VerticalStackLayout>

            <!-- Colección desplazable de productos (scroll vertical) -->
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Products}"
                            Margin="16,0,16,16"
                            RemainingItemsThreshold="5"
                            VerticalScrollBarVisibility="Always">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="12"
                                     VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <!-- Tarjeta moderna con sombra y esquinas redondeadas -->
                        <Border StrokeThickness="0"
                                BackgroundColor="#1E1E1E"
                                StrokeShape="RoundRectangle 12"
                                Padding="0">
                            <Border.Shadow>
                                <Shadow Brush="#000000"
                                        Radius="8"
                                        Offset="0,4"
                                        Opacity="0.6" />
                            </Border.Shadow>

                            <Grid RowDefinitions="160, Auto, Auto"
                                  RowSpacing="4">
                                <!-- Imagen del producto -->
                                <Image Grid.Row="0"
                                       Source="{Binding ImageUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="160">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ProductsViewModel}}, Path=ProductTappedCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Image.GestureRecognizers>
                                </Image>

                                <!-- Nombre del producto -->
                                <Label Grid.Row="1"
                                       Text="{Binding Name}"
                                       TextColor="White"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"
                                       Margin="12,10,12,0" />

                                <!-- Precio con acento neón -->
                                <Label Grid.Row="2"
                                       Text="{Binding Price, StringFormat='${0:F2}'}"
                                       TextColor="#CCFF00"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       Margin="12,0,12,14" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </RefreshView>
</ContentPage>