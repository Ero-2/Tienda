<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             xmlns:models="clr-namespace:Tienda.Models"
             x:DataType="vm:AccountViewModel"
             x:Class="Tienda.Views.NotificationsPage"
             BackgroundColor="#111111"
             NavigationPage.HasNavigationBar="False"
             Title="Notificaciones">

	<ScrollView>
		<VerticalStackLayout Padding="20,16" Spacing="12">

			<Label Text="NOTIFICACIONES DE DROPS"
                   TextColor="White"
                   FontSize="22"
                   FontAttributes="Bold"
                   CharacterSpacing="2" />

			<CollectionView ItemsSource="{Binding Notifications}">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:Notification">
						<Border BackgroundColor="#1E1E1E"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                Padding="16,12">
							<VerticalStackLayout Spacing="4">
								<Label Text="{Binding Title}" TextColor="White" FontSize="14" FontAttributes="Bold" />
								<Label Text="{Binding Message}" TextColor="#CCCCCC" FontSize="12" />
								<Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM HH:mm}'}"
                                       TextColor="#888888" FontSize="10" />
								<Label Text="{Binding IsRead, StringFormat='Leída: {0}'}"
                                       TextColor="{Binding IsRead, Converter={x:Null}}"  
								FontSize="9" />
							</VerticalStackLayout>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<!-- Reemplazamos el convertidor por una lógica simple -->
			<Label Text="No hay notificaciones."
                   TextColor="#666666"
                   FontSize="14"
                   IsVisible="{Binding Notifications.Count, Converter={x:Null}}"
                   HorizontalOptions="Center"
                   Margin="0,40,0,0" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>