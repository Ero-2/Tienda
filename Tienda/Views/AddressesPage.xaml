<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             xmlns:models="clr-namespace:Tienda.Models"
             x:DataType="vm:AccountViewModel"
             x:Class="Tienda.Views.AddressesPage"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,20,20,16" ColumnDefinitions="Auto, *">
            <Border Grid.Column="0"
                    BackgroundColor="#141414"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    Stroke="#222222"
                    WidthRequest="40" HeightRequest="40">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label Text="←" TextColor="White" FontSize="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4" Margin="14,0,0,0">
                <Label Text="MIS DIRECCIONES"
                       TextColor="White" FontSize="20"
                       FontAttributes="Bold" CharacterSpacing="2" />
                <BoxView HeightRequest="2" WidthRequest="40" Color="#CCFF00" HorizontalOptions="Start" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,32" Spacing="0">

                <!-- Lista de direcciones -->
                <CollectionView ItemsSource="{Binding Addresses}"
                                Margin="0,0,0,16">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,32,0,32">
                            <Label Text="SIN DIRECCIONES"
                                   TextColor="#2A2A2A" FontSize="11"
                                   FontAttributes="Bold" CharacterSpacing="3"
                                   HorizontalOptions="Center" />
                            <Label Text="Agrega tu primera dirección de entrega"
                                   TextColor="#1E1E1E" FontSize="12"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Address">
                            <Border BackgroundColor="#111111"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1"
                                    Stroke="#1E1E1E"
                                    Padding="18,14"
                                    Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <!-- Nombre + badge principal -->
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Name}"
                                                   TextColor="White" FontSize="14"
                                                   FontAttributes="Bold" />
                                            <Border BackgroundColor="#0D1A00"
                                                    StrokeShape="RoundRectangle 10"
                                                    StrokeThickness="0"
                                                    Padding="7,2"
                                                    IsVisible="{Binding IsDefault}">
                                                <Label Text="PRINCIPAL"
                                                       TextColor="#CCFF00"
                                                       FontSize="8" FontAttributes="Bold"
                                                       CharacterSpacing="1" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Street}"
                                               TextColor="#888888" FontSize="12" />
                                        <Label TextColor="#606060" FontSize="11">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0}, {1} {2}">
                                                    <Binding Path="City" />
                                                    <Binding Path="State" />
                                                    <Binding Path="ZipCode" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>

                                    <!-- Botón eliminar -->
                                    <Border Grid.Column="1"
                                            BackgroundColor="#1A0000"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="1"
                                            Stroke="#3A0000"
                                            WidthRequest="36" HeightRequest="36"
                                            VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccountViewModel}}, Path=DeleteAddressCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="✕" TextColor="#FF3E00" FontSize="13"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ── FORMULARIO NUEVA DIRECCIÓN ── -->

                <!-- Estado: botón agregar -->
                <Border BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        Stroke="#CCFF0044"
                        Padding="0,16"
                        IsVisible="{Binding IsAddingAddress, Converter={StaticResource InvertBoolConverter}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddAddressCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="+ NUEVA DIRECCIÓN"
                           TextColor="#CCFF00" FontSize="13"
                           FontAttributes="Bold" CharacterSpacing="1.5"
                           HorizontalOptions="Center" />
                </Border>

                <!-- Estado: formulario expandido -->
                <Border BackgroundColor="#111111"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="#1E1E1E"
                        Padding="20,18"
                        IsVisible="{Binding IsAddingAddress}">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="NUEVA DIRECCIÓN"
                               TextColor="#CCFF00" FontSize="10"
                               FontAttributes="Bold" CharacterSpacing="2.5" />

                        <!-- Nombre / Alias -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="NOMBRE / ALIAS" TextColor="#3A3A3A" FontSize="9"
                                   FontAttributes="Bold" CharacterSpacing="2" />
                            <Border BackgroundColor="#141414" StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1" Stroke="#222222" Padding="14,0">
                                <Entry Text="{Binding NewNombre}"
                                       Placeholder="Ej: Casa, Oficina"
                                       PlaceholderColor="#2A2A2A"
                                       TextColor="White" FontSize="13"
                                       BackgroundColor="Transparent" HeightRequest="46" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Calle -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="CALLE Y NÚMERO *" TextColor="#3A3A3A" FontSize="9"
                                   FontAttributes="Bold" CharacterSpacing="2" />
                            <Border BackgroundColor="#141414" StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1" Stroke="#222222" Padding="14,0">
                                <Entry Text="{Binding NewCalle}"
                                       Placeholder="Ej: Av. Reforma 123, Col. Centro"
                                       PlaceholderColor="#2A2A2A"
                                       TextColor="White" FontSize="13"
                                       BackgroundColor="Transparent" HeightRequest="46" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Ciudad + Estado -->
                        <Grid ColumnDefinitions="*, 12, *">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="CIUDAD *" TextColor="#3A3A3A" FontSize="9"
                                       FontAttributes="Bold" CharacterSpacing="2" />
                                <Border BackgroundColor="#141414" StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1" Stroke="#222222" Padding="12,0">
                                    <Entry Text="{Binding NewCiudad}"
                                           Placeholder="CDMX"
                                           PlaceholderColor="#2A2A2A"
                                           TextColor="White" FontSize="13"
                                           BackgroundColor="Transparent" HeightRequest="46" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="6">
                                <Label Text="ESTADO" TextColor="#3A3A3A" FontSize="9"
                                       FontAttributes="Bold" CharacterSpacing="2" />
                                <Border BackgroundColor="#141414" StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1" Stroke="#222222" Padding="12,0">
                                    <Entry Text="{Binding NewEstado}"
                                           Placeholder="CDMX"
                                           PlaceholderColor="#2A2A2A"
                                           TextColor="White" FontSize="13"
                                           BackgroundColor="Transparent" HeightRequest="46" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- CP -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="CÓDIGO POSTAL" TextColor="#3A3A3A" FontSize="9"
                                   FontAttributes="Bold" CharacterSpacing="2" />
                            <Border BackgroundColor="#141414" StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1" Stroke="#222222" Padding="14,0">
                                <Entry Text="{Binding NewCodigoPostal}"
                                       Placeholder="06600"
                                       PlaceholderColor="#2A2A2A"
                                       TextColor="White" FontSize="13"
                                       Keyboard="Numeric" MaxLength="5"
                                       BackgroundColor="Transparent" HeightRequest="46" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Switch principal -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Establecer como dirección principal"
                                   TextColor="#808080" FontSize="12"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding NewEsPrincipal}"
                                    OnColor="#CCFF00"
                                    ThumbColor="White" />
                        </Grid>

                        <!-- Error -->
                        <Label Text="{Binding AddAddressError}"
                               TextColor="#FF3E00" FontSize="12"
                               IsVisible="{Binding AddAddressError, Converter={StaticResource NotEmptyConverter}}" />

                        <!-- Botones -->
                        <Grid ColumnDefinitions="*, 12, *" Margin="0,4,0,0">
                            <Border Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1"
                                    Stroke="#2A2A2A"
                                    Padding="0,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CancelAddAddressCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="CANCELAR"
                                       TextColor="#606060" FontSize="12"
                                       FontAttributes="Bold" CharacterSpacing="1"
                                       HorizontalOptions="Center" />
                            </Border>
                            <Border Grid.Column="2"
                                    BackgroundColor="#CCFF00"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    Padding="0,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SaveNewAddressCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="GUARDAR"
                                       TextColor="#0D0D0D" FontSize="12"
                                       FontAttributes="Bold" CharacterSpacing="1"
                                       HorizontalOptions="Center" />
                            </Border>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
