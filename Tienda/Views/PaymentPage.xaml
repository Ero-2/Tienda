<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             x:DataType="vm:PaymentViewModel"
             x:Class="Tienda.Views.PaymentPage"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,32" Spacing="0">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" Margin="0,0,0,28">
                <Border Grid.Column="0"
                        BackgroundColor="#141414"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="1"
                        Stroke="#222222"
                        WidthRequest="40" HeightRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="←" TextColor="White" FontSize="18"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                    <Label Text="PAGO SEGURO"
                           TextColor="White" FontSize="20" FontAttributes="Bold" CharacterSpacing="2" />
                    <BoxView HeightRequest="2" WidthRequest="40" Color="#CCFF00" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Grid>

            <!-- Total -->
            <Border BackgroundColor="#111111"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1"
                    Stroke="#1E1E1E"
                    Padding="20,16"
                    Margin="0,0,0,20">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="TOTAL A PAGAR"
                               TextColor="#404040" FontSize="9"
                               FontAttributes="Bold" CharacterSpacing="2" />
                        <Label Text="{Binding ModalidadPago}"
                               TextColor="#606060" FontSize="11" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="{Binding Total, StringFormat='${0:F2}'}"
                           TextColor="#CCFF00"
                           FontSize="28"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Tarjeta visual -->
            <Border BackgroundColor="#111111"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="#1E1E1E"
                    Padding="22,18"
                    Margin="0,0,0,24">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="THE DROP"
                               TextColor="#CCFF00" FontSize="12"
                               FontAttributes="Bold" CharacterSpacing="3" />
                        <Label Grid.Column="1" Text="VISA / MC"
                               TextColor="#3A3A3A" FontSize="10"
                               FontAttributes="Bold" CharacterSpacing="1" />
                    </Grid>
                    <Label Text="{Binding NumeroTarjeta, StringFormat='{0}'}"
                           TextColor="White" FontSize="20" FontAttributes="Bold"
                           CharacterSpacing="4" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="{Binding Titular}"
                               TextColor="#606060" FontSize="12" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="{Binding MesExpiracion}" TextColor="#606060" FontSize="12" />
                            <Label Text="/" TextColor="#404040" FontSize="12" />
                            <Label Text="{Binding AnioExpiracion}" TextColor="#606060" FontSize="12" />
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Campos -->
            <Label Text="NÚMERO DE TARJETA"
                   TextColor="#3A3A3A" FontSize="9"
                   FontAttributes="Bold" CharacterSpacing="2.5"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                    StrokeThickness="1" Stroke="#222222" Padding="16,0" Margin="0,0,0,16">
                <Entry Text="{Binding NumeroTarjeta}"
                       Placeholder="1234 5678 9012 3456"
                       PlaceholderColor="#2A2A2A"
                       TextColor="White" FontSize="14"
                       Keyboard="Numeric" MaxLength="19"
                       BackgroundColor="Transparent" HeightRequest="50" />
            </Border>

            <Label Text="NOMBRE EN LA TARJETA"
                   TextColor="#3A3A3A" FontSize="9"
                   FontAttributes="Bold" CharacterSpacing="2.5"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                    StrokeThickness="1" Stroke="#222222" Padding="16,0" Margin="0,0,0,16">
                <Entry Text="{Binding Titular}"
                       Placeholder="JUAN PEREZ"
                       PlaceholderColor="#2A2A2A"
                       TextColor="White" FontSize="14"
                       BackgroundColor="Transparent" HeightRequest="50" />
            </Border>

            <!-- Exp + CVV -->
            <Grid ColumnDefinitions="*, 12, *, 12, *" Margin="0,0,0,20">
                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="MES" TextColor="#3A3A3A" FontSize="9"
                           FontAttributes="Bold" CharacterSpacing="2.5" />
                    <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                            StrokeThickness="1" Stroke="#222222" Padding="12,0">
                        <Entry Text="{Binding MesExpiracion}"
                               Placeholder="12" PlaceholderColor="#2A2A2A"
                               TextColor="White" FontSize="14"
                               Keyboard="Numeric" MaxLength="2"
                               BackgroundColor="Transparent" HeightRequest="50"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="8">
                    <Label Text="AÑO" TextColor="#3A3A3A" FontSize="9"
                           FontAttributes="Bold" CharacterSpacing="2.5" />
                    <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                            StrokeThickness="1" Stroke="#222222" Padding="12,0">
                        <Entry Text="{Binding AnioExpiracion}"
                               Placeholder="26" PlaceholderColor="#2A2A2A"
                               TextColor="White" FontSize="14"
                               Keyboard="Numeric" MaxLength="2"
                               BackgroundColor="Transparent" HeightRequest="50"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="4" Spacing="8">
                    <Label Text="CVV" TextColor="#3A3A3A" FontSize="9"
                           FontAttributes="Bold" CharacterSpacing="2.5" />
                    <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                            StrokeThickness="1" Stroke="#222222" Padding="12,0">
                        <Entry Text="{Binding Cvv}"
                               Placeholder="123" PlaceholderColor="#2A2A2A"
                               TextColor="White" FontSize="14"
                               Keyboard="Numeric" MaxLength="4"
                               IsPassword="True"
                               BackgroundColor="Transparent" HeightRequest="50"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Error -->
            <Border BackgroundColor="#1A0000"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    Stroke="#3A0000"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmptyConverter}}">
                <Label Text="{Binding ErrorMessage}" TextColor="#FF3E00" FontSize="12" />
            </Border>

            <!-- Botón pagar -->
            <Border BackgroundColor="#CCFF00"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="0"
                    Margin="0,4,0,0"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PagarCommand}" />
                </Border.GestureRecognizers>
                <Grid HeightRequest="56">
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="#0D0D0D"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                    <VerticalStackLayout IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="2">
                        <Label Text="PAGAR AHORA"
                               TextColor="#0D0D0D" FontSize="15"
                               FontAttributes="Bold" CharacterSpacing="2.5"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Total, StringFormat='${0:F2} USD'}"
                               TextColor="#0D0D0D" FontSize="11"
                               HorizontalOptions="Center"
                               Opacity="0.6" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Seguridad -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,16,0,0">
                <Label Text="—" TextColor="#252525" FontSize="10" VerticalOptions="Center" />
                <Label Text="PAGO SEGURO · ENCRIPTACIÓN SSL · OPENPAY"
                       TextColor="#252525" FontSize="9"
                       FontAttributes="Bold" CharacterSpacing="1"
                       VerticalOptions="Center" />
                <Label Text="—" TextColor="#252525" FontSize="10" VerticalOptions="Center" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
