<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             x:DataType="vm:PaymentViewModel"
             x:Class="Tienda.Views.PaymentPage"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,32" Spacing="0">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" Margin="0,0,0,28">
                <Border Grid.Column="0"
                        BackgroundColor="#141414"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="1"
                        Stroke="#222222"
                        WidthRequest="40" HeightRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="←" TextColor="White" FontSize="18"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                    <Label Text="PAGO SEGURO"
                           TextColor="White" FontSize="20" FontAttributes="Bold" CharacterSpacing="2" />
                    <BoxView HeightRequest="2" WidthRequest="40" Color="#CCFF00" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Grid>

            <!-- Selector modalidad de pago -->
            <Label Text="MODALIDAD DE PAGO"
                   TextColor="#3A3A3A" FontSize="9"
                   FontAttributes="Bold" CharacterSpacing="2"
                   Margin="0,0,0,8" />

            <CollectionView ItemsSource="{Binding PaymentOptions}"
                            SelectionMode="Single"
                            SelectedItem="{Binding ModalidadPago}"
                            HeightRequest="44"
                            Margin="0,0,0,20">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border StrokeShape="RoundRectangle 20"
                                StrokeThickness="1"
                                BackgroundColor="Transparent"
                                Stroke="#252525"
                                Padding="14,10">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                                <Setter Property="Stroke" Value="#252525" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#CCFF00" />
                                                <Setter Property="Stroke" Value="#CCFF00" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding .}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="TextColor" Value="#666666" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="TextColor" Value="#0D0D0D" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Label>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Desglose de pago -->
            <Border BackgroundColor="#111111"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1"
                    Stroke="#1E1E1E"
                    Padding="20,16"
                    Margin="0,0,0,20">
                <VerticalStackLayout Spacing="10">

                    <!-- Subtotal -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="SUBTOTAL"
                               TextColor="#404040" FontSize="9"
                               FontAttributes="Bold" CharacterSpacing="2" />
                        <Label Grid.Column="1"
                               Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                               TextColor="#888888" FontSize="14" />
                    </Grid>

                    <!-- Descuento -->
                    <Grid ColumnDefinitions="*, Auto"
                          IsVisible="{Binding Descuento, Converter={StaticResource NotZeroConverter}}">
                        <Label Grid.Column="0" Text="DESCUENTO"
                               TextColor="#404040" FontSize="9"
                               FontAttributes="Bold" CharacterSpacing="2" />
                        <Label Grid.Column="1"
                               Text="{Binding Descuento, StringFormat='-${0:F2}'}"
                               TextColor="#CCFF00" FontSize="14" />
                    </Grid>

                    <!-- Envío -->
                    <Grid ColumnDefinitions="*, Auto"
                          IsVisible="{Binding CostoEnvio, Converter={StaticResource NotZeroConverter}}">
                        <Label Grid.Column="0" Text="ENVÍO"
                               TextColor="#404040" FontSize="9"
                               FontAttributes="Bold" CharacterSpacing="2" />
                        <Label Grid.Column="1"
                               Text="{Binding CostoEnvio, StringFormat='${0:F2}'}"
                               TextColor="#888888" FontSize="14" />
                    </Grid>

                    <BoxView Color="#1E1E1E" HeightRequest="1" />

                    <!-- Total -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="TOTAL A PAGAR"
                                   TextColor="#404040" FontSize="9"
                                   FontAttributes="Bold" CharacterSpacing="2" />
                            <Label Text="{Binding ModalidadPago}"
                                   TextColor="#606060" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding Total, StringFormat='${0:F2}'}"
                               TextColor="#CCFF00"
                               FontSize="28"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- MSI mensualidad -->
                    <Border BackgroundColor="#0D1A00"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="1"
                            Stroke="#CCFF0033"
                            Padding="10,6"
                            IsVisible="{Binding MsiLabel, Converter={StaticResource NotEmptyConverter}}">
                        <Label Text="{Binding MsiLabel}"
                               TextColor="#CCFF00"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Panel crédito (visible cuando EsPagoCredito) -->
            <Border BackgroundColor="#0D1A00"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="#CCFF0033"
                    Padding="22,20"
                    Margin="0,0,0,24"
                    IsVisible="{Binding EsPagoCredito}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="CRÉDITO DISPONIBLE"
                                   TextColor="#CCFF00" FontSize="9"
                                   FontAttributes="Bold" CharacterSpacing="2.5" />
                            <Label Text="{Binding CreditoDisponible, StringFormat='${0:F2} USD'}"
                                   TextColor="White" FontSize="28" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#CCFF0022"
                                StrokeShape="RoundRectangle 6"
                                StrokeThickness="0"
                                Padding="10,6"
                                VerticalOptions="Center">
                            <Label Text="ACTIVO" TextColor="#CCFF00"
                                   FontSize="9" FontAttributes="Bold" CharacterSpacing="2" />
                        </Border>
                    </Grid>
                    <BoxView Color="#CCFF0022" HeightRequest="1" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="CARGO POR ESTA COMPRA"
                               TextColor="#606060" FontSize="10" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding Total, StringFormat='-${0:F2}'}"
                               TextColor="#CCFF00" FontSize="16" FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                    <Border BackgroundColor="#1A0000"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="1"
                            Stroke="#3A0000"
                            Padding="12,8"
                            IsVisible="{Binding CreditoDisponible, Converter={StaticResource NotZeroConverter}}">
                        <Label TextColor="#FF3E00" FontSize="11" HorizontalOptions="Center">
                            <Label.Text>
                                <MultiBinding StringFormat="Saldo restante: ${0:F2}">
                                    <Binding Path="CreditoDisponible" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Tarjeta visual (solo para pago con tarjeta) -->
            <Border BackgroundColor="#111111"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="#1E1E1E"
                    Padding="22,18"
                    Margin="0,0,0,24"
                    IsVisible="{Binding EsPagoTarjeta}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="THE DROP"
                               TextColor="#CCFF00" FontSize="12"
                               FontAttributes="Bold" CharacterSpacing="3" />
                        <Label Grid.Column="1" Text="VISA / MC"
                               TextColor="#3A3A3A" FontSize="10"
                               FontAttributes="Bold" CharacterSpacing="1" />
                    </Grid>
                    <Label Text="{Binding NumeroTarjeta, StringFormat='{0}'}"
                           TextColor="White" FontSize="20" FontAttributes="Bold"
                           CharacterSpacing="4" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="{Binding Titular}"
                               TextColor="#606060" FontSize="12" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="{Binding MesExpiracion}" TextColor="#606060" FontSize="12" />
                            <Label Text="/" TextColor="#404040" FontSize="12" />
                            <Label Text="{Binding AnioExpiracion}" TextColor="#606060" FontSize="12" />
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Campos tarjeta (ocultos si EsPagoCredito) -->
            <VerticalStackLayout IsVisible="{Binding EsPagoTarjeta}" Spacing="0">

            <Label Text="NÚMERO DE TARJETA"
                   TextColor="#3A3A3A" FontSize="9"
                   FontAttributes="Bold" CharacterSpacing="2.5"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                    StrokeThickness="1" Stroke="#222222" Padding="16,0" Margin="0,0,0,16">
                <Entry Text="{Binding NumeroTarjeta}"
                       Placeholder="1234 5678 9012 3456"
                       PlaceholderColor="#2A2A2A"
                       TextColor="White" FontSize="14"
                       Keyboard="Numeric" MaxLength="19"
                       BackgroundColor="Transparent" HeightRequest="50" />
            </Border>

            <Label Text="NOMBRE EN LA TARJETA"
                   TextColor="#3A3A3A" FontSize="9"
                   FontAttributes="Bold" CharacterSpacing="2.5"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                    StrokeThickness="1" Stroke="#222222" Padding="16,0" Margin="0,0,0,16">
                <Entry Text="{Binding Titular}"
                       Placeholder="JUAN PEREZ"
                       PlaceholderColor="#2A2A2A"
                       TextColor="White" FontSize="14"
                       BackgroundColor="Transparent" HeightRequest="50" />
            </Border>

            <Label Text="CORREO ELECTRÓNICO"
                   TextColor="#3A3A3A" FontSize="9"
                   FontAttributes="Bold" CharacterSpacing="2.5"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                    StrokeThickness="1" Stroke="#222222" Padding="16,0" Margin="0,0,0,16">
                <Entry Text="{Binding Email}"
                       Placeholder="correo@ejemplo.com"
                       PlaceholderColor="#2A2A2A"
                       TextColor="White" FontSize="14"
                       Keyboard="Email"
                       BackgroundColor="Transparent" HeightRequest="50" />
            </Border>

            <!-- Exp + CVV -->
            <Grid ColumnDefinitions="*, 12, *, 12, *" Margin="0,0,0,20">
                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="MES" TextColor="#3A3A3A" FontSize="9"
                           FontAttributes="Bold" CharacterSpacing="2.5" />
                    <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                            StrokeThickness="1" Stroke="#222222" Padding="12,0">
                        <Entry Text="{Binding MesExpiracion}"
                               Placeholder="12" PlaceholderColor="#2A2A2A"
                               TextColor="White" FontSize="14"
                               Keyboard="Numeric" MaxLength="2"
                               BackgroundColor="Transparent" HeightRequest="50"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="8">
                    <Label Text="AÑO" TextColor="#3A3A3A" FontSize="9"
                           FontAttributes="Bold" CharacterSpacing="2.5" />
                    <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                            StrokeThickness="1" Stroke="#222222" Padding="12,0">
                        <Entry Text="{Binding AnioExpiracion}"
                               Placeholder="2030" PlaceholderColor="#2A2A2A"
                               TextColor="White" FontSize="14"
                               Keyboard="Numeric" MaxLength="4"
                               BackgroundColor="Transparent" HeightRequest="50"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="4" Spacing="8">
                    <Label Text="CVV" TextColor="#3A3A3A" FontSize="9"
                           FontAttributes="Bold" CharacterSpacing="2.5" />
                    <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                            StrokeThickness="1" Stroke="#222222" Padding="12,0">
                        <Entry Text="{Binding Cvv}"
                               Placeholder="123" PlaceholderColor="#2A2A2A"
                               TextColor="White" FontSize="14"
                               Keyboard="Numeric" MaxLength="4"
                               IsPassword="True"
                               BackgroundColor="Transparent" HeightRequest="50"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            </VerticalStackLayout>

            <!-- Error -->
            <Border BackgroundColor="#1A0000"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    Stroke="#3A0000"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmptyConverter}}">
                <Label Text="{Binding ErrorMessage}" TextColor="#FF3E00" FontSize="12" />
            </Border>

            <!-- Botón pagar -->
            <Border BackgroundColor="#CCFF00"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="0"
                    Margin="0,4,0,0"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PagarCommand}" />
                </Border.GestureRecognizers>
                <Grid HeightRequest="56">
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="#0D0D0D"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                    <VerticalStackLayout IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="2">
                        <Label Text="PAGAR AHORA"
                               TextColor="#0D0D0D" FontSize="15"
                               FontAttributes="Bold" CharacterSpacing="2.5"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Total, StringFormat='${0:F2} USD'}"
                               TextColor="#0D0D0D" FontSize="11"
                               HorizontalOptions="Center"
                               Opacity="0.6" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Seguridad -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,16,0,0">
                <Label Text="—" TextColor="#252525" FontSize="10" VerticalOptions="Center" />
                <Label Text="PAGO SEGURO · ENCRIPTACIÓN SSL · OPENPAY"
                       TextColor="#252525" FontSize="9"
                       FontAttributes="Bold" CharacterSpacing="1"
                       VerticalOptions="Center" />
                <Label Text="—" TextColor="#252525" FontSize="10" VerticalOptions="Center" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
