<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             xmlns:models="clr-namespace:Tienda.Models"
             x:DataType="vm:OrderHistoryViewModel"
             x:Class="Tienda.Views.OrderHistoryPage"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False"
             Title="Historial">

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,20,20,16" ColumnDefinitions="Auto, *" ColumnSpacing="14">
            <Border Grid.Column="0"
                    BackgroundColor="#141414"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    Stroke="#222222"
                    WidthRequest="40" HeightRequest="40">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label Text="←" TextColor="White" FontSize="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label Text="MIS PEDIDOS"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       CharacterSpacing="2.5" />
                <BoxView HeightRequest="2" WidthRequest="40" Color="#CCFF00" HorizontalOptions="Start" />
            </VerticalStackLayout>
        </Grid>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#CCFF00"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Lista -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Orders}"
                        Margin="16,4,16,16"
                        IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                     Spacing="12" Margin="0,60,0,0">
                    <Label Text="—"
                           TextColor="#CCFF00"
                           FontSize="32"
                           FontAttributes="Bold"
                           CharacterSpacing="6"
                           HorizontalOptions="Center" />
                    <Label Text="SIN PEDIDOS AÚN"
                           TextColor="#3A3A3A"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="3"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Order">
                    <Border BackgroundColor="#111111"
                            StrokeShape="RoundRectangle 0"
                            StrokeThickness="0"
                            Padding="18,18"
                            Margin="0,0,0,2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToDetailCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <!-- Línea accent izquierda -->
                        <Grid ColumnDefinitions="3, *" ColumnSpacing="16">
                            <BoxView Grid.Column="0" Color="#CCFF00"
                                     VerticalOptions="Fill" />
                            <Grid Grid.Column="1" RowDefinitions="Auto, Auto, Auto" RowSpacing="10">

                                <!-- ID + Fecha -->
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Id}"
                                           TextColor="White"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           CharacterSpacing="0.5" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
                                           TextColor="#404040"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </Grid>

                                <!-- Total + Status -->
                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Total, StringFormat='${0:F2}'}"
                                           TextColor="#CCFF00"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="1"
                                            BackgroundColor="#0A1A00"
                                            StrokeShape="RoundRectangle 20"
                                            StrokeThickness="1"
                                            Stroke="#1A3A00"
                                            Padding="12,5">
                                        <Label Text="{Binding Status}"
                                               TextColor="#CCFF00"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               CharacterSpacing="1.5" />
                                    </Border>
                                </Grid>

                                <!-- Rastreo link -->
                                <Border Grid.Row="2"
                                        BackgroundColor="Transparent"
                                        StrokeShape="RoundRectangle 0"
                                        StrokeThickness="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToTrackingCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="Ver seguimiento"
                                               TextColor="#606060"
                                               FontSize="11" />
                                        <Label Text="→"
                                               TextColor="#CCFF00"
                                               FontSize="11" />
                                    </HorizontalStackLayout>
                                </Border>

                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
