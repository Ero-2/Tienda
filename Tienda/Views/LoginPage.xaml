<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             x:DataType="vm:LoginViewModel"
             x:Class="Tienda.Views.LoginPage"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False"
             Title="Login">

    <ScrollView>
        <Grid RowDefinitions="*, Auto">
            <VerticalStackLayout Padding="28,64,28,40" Spacing="0">

                <!-- Branding -->
                <BoxView Color="#CCFF00" HeightRequest="3" WidthRequest="32"
                         HorizontalOptions="Start" Margin="0,0,0,20" />

                <Label Text="THE DROP"
                       TextColor="White"
                       FontSize="36"
                       FontAttributes="Bold"
                       CharacterSpacing="4"
                       HorizontalOptions="Start" />

                <Label Text="SS25 · NUEVA OLA"
                       TextColor="#3A3A3A"
                       FontSize="10"
                       FontAttributes="Bold"
                       CharacterSpacing="4"
                       Margin="0,6,0,52" />

                <!-- Email -->
                <Label Text="CORREO"
                       TextColor="#3A3A3A"
                       FontSize="9"
                       FontAttributes="Bold"
                       CharacterSpacing="2.5"
                       Margin="0,0,0,8" />
                <Border BackgroundColor="#111111"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        Stroke="#222222"
                        Padding="16,0"
                        Margin="0,0,0,16">
                    <Entry Text="{Binding Email}"
                           Placeholder="usuario@mail.com"
                           PlaceholderColor="#303030"
                           TextColor="White"
                           FontSize="14"
                           Keyboard="Email"
                           BackgroundColor="Transparent"
                           HeightRequest="50" />
                </Border>

                <!-- Password -->
                <Label Text="CONTRASEÑA"
                       TextColor="#3A3A3A"
                       FontSize="9"
                       FontAttributes="Bold"
                       CharacterSpacing="2.5"
                       Margin="0,0,0,8" />
                <Border BackgroundColor="#111111"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        Stroke="#222222"
                        Padding="16,0"
                        Margin="0,0,0,10">
                    <Entry Text="{Binding Password}"
                           IsPassword="True"
                           Placeholder="Mínimo 6 caracteres"
                           PlaceholderColor="#303030"
                           TextColor="White"
                           FontSize="14"
                           BackgroundColor="Transparent"
                           HeightRequest="50" />
                </Border>

                <!-- Forgot -->
                <Label Text="¿Olvidaste tu contraseña?"
                       TextColor="#505050"
                       FontSize="11"
                       HorizontalOptions="End"
                       Margin="0,0,0,28">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Error -->
                <Border BackgroundColor="#1A0000"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="1"
                        Stroke="#3A0000"
                        Padding="14,10"
                        Margin="0,0,0,14"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmptyConverter}}">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#FF3E00"
                           FontSize="12" />
                </Border>

                <!-- Login Button -->
                <Border BackgroundColor="#CCFF00"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        Margin="0,0,0,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LoginCommand}" />
                    </Border.GestureRecognizers>
                    <Grid HeightRequest="52">
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="#0D0D0D"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                        <Label Text="INICIAR SESIÓN"
                               TextColor="#0D0D0D"
                               FontSize="14"
                               FontAttributes="Bold"
                               CharacterSpacing="2.5"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}" />
                    </Grid>
                </Border>

                <!-- Register -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,28,0,0">
                    <Label Text="¿No tienes cuenta?" TextColor="#303030" FontSize="12" />
                    <Label Text="REGÍSTRATE"
                           TextColor="#CCFF00"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
                <!-- Invitado -->
                <Label Text="CONTINUAR COMO INVITADO"
                           TextColor="#505050"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           HorizontalOptions="Center"
                           Margin="0,16,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ContinueAsGuestCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
