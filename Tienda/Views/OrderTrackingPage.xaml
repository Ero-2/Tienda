<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             xmlns:models="clr-namespace:Tienda.Models"
             x:DataType="vm:OrderTrackingViewModel"
             x:Class="Tienda.Views.OrderTrackingPage"
             BackgroundColor="#111111"
             NavigationPage.HasNavigationBar="False">

	<ScrollView>
		<VerticalStackLayout Padding="20,16" Spacing="0">
			<Label Text="SEGUIMIENTO" TextColor="White" FontSize="22" FontAttributes="Bold" />
			<Label Text="{Binding OrderId, StringFormat='#{0}'}" TextColor="#555555" FontSize="12" Margin="0,4,0,24" />

			<!-- Timeline -->
			<CollectionView ItemsSource="{Binding Steps}" HeightRequest="340">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:OrderStep">
						<Grid ColumnDefinitions="40, *" ColumnSpacing="16" Padding="0,0,0,28">
							<VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
								<Border WidthRequest="26"
                                        HeightRequest="26"
                                        StrokeShape="RoundRectangle 13"
                                        BackgroundColor="{Binding Status, Converter={StaticResource StepColorConverter}}"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center">
									<Label Text="{Binding Status, Converter={StaticResource StepIconConverter}}"
                                           TextColor="#111111"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
								</Border>
								<BoxView Color="{Binding Status, Converter={StaticResource StepLineColorConverter}}"
                                         WidthRequest="2"
                                         HeightRequest="28"
                                         HorizontalOptions="Center" />
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="1" VerticalOptions="Start" Padding="0,2,0,0">
								<Label Text="{Binding Title}"
                                       TextColor="{Binding Status, Converter={StaticResource StepTextColorConverter}}"
                                       FontSize="14"
                                       FontAttributes="Bold" />
								<Label Text="{Binding Subtitle}"
                                       TextColor="{Binding Status, Converter={StaticResource StepSubtextColorConverter}}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
							</VerticalStackLayout>
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<!-- Tarjeta rastreo -->
			<Border BackgroundColor="#1E1E1E"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    Padding="18,16"
                    Margin="0,0,0,24">
				<VerticalStackLayout Spacing="4">
					<Label Text="NÚMERO DE RASTREO" TextColor="#555555" FontSize="9" CharacterSpacing="2" />
					<Label Text="{Binding TrackingNumber}" TextColor="White" FontSize="19" FontAttributes="Bold" CharacterSpacing="2" />
					<Label Text="{Binding EstimatedDelivery, StringFormat='Entrega estimada: {0}'}"
                           TextColor="#CCFF00" FontSize="12" />
				</VerticalStackLayout>
			</Border>

			<!-- Volver -->
			<Border BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="#2E2E2E"
                    Padding="0,14">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding GoToHomeCommand}" />
				</Border.GestureRecognizers>
				<Label Text="SEGUIR COMPRANDO"
                       TextColor="White"
                       FontSize="13"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       HorizontalOptions="Center" />
			</Border>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>