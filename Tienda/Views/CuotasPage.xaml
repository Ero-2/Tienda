<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             x:DataType="vm:CuotasViewModel"
             x:Class="Tienda.Views.CuotasPage"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,32" Spacing="0">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" Margin="0,0,0,28">
                <Border Grid.Column="0"
                        BackgroundColor="#141414"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="1"
                        Stroke="#222222"
                        WidthRequest="40" HeightRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="←" TextColor="White" FontSize="18"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                    <Label Text="PAGAR CUOTA"
                           TextColor="White" FontSize="20" FontAttributes="Bold" CharacterSpacing="2" />
                    <BoxView HeightRequest="2" WidthRequest="40" Color="#CCFF00" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Grid>

            <!-- Info plan -->
            <Border BackgroundColor="#111111"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1"
                    Stroke="#1E1E1E"
                    Padding="20,16"
                    Margin="0,0,0,24">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="PLAN DE PAGO"
                               TextColor="#3A3A3A" FontSize="9"
                               FontAttributes="Bold" CharacterSpacing="2" />
                        <Label Text="{Binding PlanId, StringFormat='Plan #{0}'}"
                               TextColor="White" FontSize="16" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="MSI"
                           TextColor="#CCFF00" FontSize="11"
                           FontAttributes="Bold" CharacterSpacing="2"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Datos de tarjeta -->
            <Label Text="NÚMERO DE TARJETA"
                   TextColor="#3A3A3A" FontSize="9"
                   FontAttributes="Bold" CharacterSpacing="2.5"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                    StrokeThickness="1" Stroke="#222222" Padding="16,0" Margin="0,0,0,16">
                <Entry Text="{Binding NumeroTarjeta}"
                       Placeholder="1234 5678 9012 3456"
                       PlaceholderColor="#2A2A2A"
                       TextColor="White" FontSize="14"
                       Keyboard="Numeric" MaxLength="19"
                       BackgroundColor="Transparent" HeightRequest="50" />
            </Border>

            <Label Text="NOMBRE EN LA TARJETA"
                   TextColor="#3A3A3A" FontSize="9"
                   FontAttributes="Bold" CharacterSpacing="2.5"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                    StrokeThickness="1" Stroke="#222222" Padding="16,0" Margin="0,0,0,16">
                <Entry Text="{Binding Titular}"
                       Placeholder="JUAN PEREZ"
                       PlaceholderColor="#2A2A2A"
                       TextColor="White" FontSize="14"
                       BackgroundColor="Transparent" HeightRequest="50" />
            </Border>

            <Grid ColumnDefinitions="*, 12, *, 12, *" Margin="0,0,0,24">
                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="MES" TextColor="#3A3A3A" FontSize="9"
                           FontAttributes="Bold" CharacterSpacing="2.5" />
                    <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                            StrokeThickness="1" Stroke="#222222" Padding="12,0">
                        <Entry Text="{Binding MesExpiracion}"
                               Placeholder="12" PlaceholderColor="#2A2A2A"
                               TextColor="White" FontSize="14"
                               Keyboard="Numeric" MaxLength="2"
                               BackgroundColor="Transparent" HeightRequest="50"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="8">
                    <Label Text="AÑO" TextColor="#3A3A3A" FontSize="9"
                           FontAttributes="Bold" CharacterSpacing="2.5" />
                    <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                            StrokeThickness="1" Stroke="#222222" Padding="12,0">
                        <Entry Text="{Binding AnioExpiracion}"
                               Placeholder="2030" PlaceholderColor="#2A2A2A"
                               TextColor="White" FontSize="14"
                               Keyboard="Numeric" MaxLength="4"
                               BackgroundColor="Transparent" HeightRequest="50"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="4" Spacing="8">
                    <Label Text="CVV" TextColor="#3A3A3A" FontSize="9"
                           FontAttributes="Bold" CharacterSpacing="2.5" />
                    <Border BackgroundColor="#111111" StrokeShape="RoundRectangle 8"
                            StrokeThickness="1" Stroke="#222222" Padding="12,0">
                        <Entry Text="{Binding Cvv}"
                               Placeholder="123" PlaceholderColor="#2A2A2A"
                               TextColor="White" FontSize="14"
                               Keyboard="Numeric" MaxLength="4"
                               IsPassword="True"
                               BackgroundColor="Transparent" HeightRequest="50"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Error -->
            <Border BackgroundColor="#1A0000"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    Stroke="#3A0000"
                    Padding="14,10"
                    Margin="0,0,0,10"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmptyConverter}}">
                <Label Text="{Binding ErrorMessage}" TextColor="#FF3E00" FontSize="12" />
            </Border>

            <!-- Éxito -->
            <Border BackgroundColor="#001A00"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    Stroke="#00AA00"
                    Padding="14,10"
                    Margin="0,0,0,10"
                    IsVisible="{Binding SuccessMessage, Converter={StaticResource NotEmptyConverter}}">
                <Label Text="{Binding SuccessMessage}" TextColor="#00CC00" FontSize="12"
                       FontAttributes="Bold" HorizontalOptions="Center" />
            </Border>

            <!-- Botón pagar -->
            <Border BackgroundColor="#CCFF00"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="0"
                    Margin="0,4,0,0"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PagarCuotaCommand}" />
                </Border.GestureRecognizers>
                <Grid HeightRequest="56">
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="#0D0D0D"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                    <Label IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                           Text="PAGAR CUOTA"
                           TextColor="#0D0D0D" FontSize="15"
                           FontAttributes="Bold" CharacterSpacing="2.5"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
