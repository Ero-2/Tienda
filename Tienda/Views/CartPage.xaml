<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             xmlns:models="clr-namespace:Tienda.Models"
             x:DataType="vm:CartViewModel"
             x:Class="Tienda.Views.CartPage"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,20,20,16" ColumnDefinitions="*, Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="4">
                <Label Text="CARRITO"
                       TextColor="White"
                       FontSize="24"
                       FontAttributes="Bold"
                       CharacterSpacing="2.5" />
                <BoxView Color="#CCFF00" HeightRequest="2" WidthRequest="40" HorizontalOptions="Start" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    BackgroundColor="#1C1C1C"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1"
                    Stroke="#252525"
                    Padding="12,5"
                    VerticalOptions="Center">
                <Label Text="{Binding TotalItemCount, StringFormat='{0} items'}"
                       TextColor="#888888"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1" />
            </Border>
        </Grid>

        <!-- Items + resumen (un solo scroll) -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        Margin="0,0,0,4">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                     Spacing="14" Margin="0,60,0,0">
                    <Label Text="—"
                           TextColor="#CCFF00"
                           FontSize="32"
                           FontAttributes="Bold"
                           CharacterSpacing="6"
                           HorizontalOptions="Center" />
                    <Label Text="CARRITO VACÍO"
                           TextColor="#3A3A3A"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="3"
                           HorizontalOptions="Center" />
                    <Label Text="Agrega productos desde el catálogo"
                           TextColor="#282828"
                           FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CartItem">
                    <Grid ColumnDefinitions="72, *, Auto"
                          Padding="16,14"
                          ColumnSpacing="14">

                        <!-- Imagen -->
                        <Border Grid.Column="0"
                                BackgroundColor="#151515"
                                StrokeShape="RoundRectangle 6"
                                StrokeThickness="1"
                                Stroke="#1E1E1E"
                                HeightRequest="72"
                                WidthRequest="72">
                            <Image Source="{Binding Product.ImageUrl}" Aspect="AspectFill" />
                        </Border>

                        <!-- Info -->
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Product.Brand}"
                                   TextColor="#CCFF00"
                                   FontSize="9"
                                   CharacterSpacing="2" />
                            <Label Text="{Binding Product.Name}"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Size, StringFormat='TALLA {0}'}"
                                   TextColor="#505050"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   Margin="0,2,0,0" />
                            <!-- Cantidad -->
                            <HorizontalStackLayout Spacing="14" Margin="0,8,0,0">
                                <Border BackgroundColor="#141414"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="1"
                                        Stroke="#252525"
                                        WidthRequest="30"
                                        HeightRequest="30">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=DecreaseQuantityCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="−" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           FontSize="15" FontAttributes="Bold" />
                                </Border>
                                <Label Text="{Binding Quantity}"
                                       TextColor="White"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       MinimumWidthRequest="20"
                                       HorizontalTextAlignment="Center" />
                                <Border BackgroundColor="#141414"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="1"
                                        Stroke="#252525"
                                        WidthRequest="30"
                                        HeightRequest="30">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=IncreaseQuantityCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="+" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           FontSize="15" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Precio (total de línea) -->
                        <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Start" Margin="0,4,0,0">
                            <Label Text="{Binding LineTotal, StringFormat='${0:F2}'}"
                                   TextColor="#CCFF00"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   HorizontalOptions="End" />
                            <Label Text="{Binding Product.Price, StringFormat='${0:F2} c/u'}"
                                   TextColor="#404040"
                                   FontSize="10"
                                   HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Resumen + dirección: viajan dentro del scroll, no en un footer fijo -->
            <CollectionView.Footer>
                <VerticalStackLayout Padding="20,16,20,24" Spacing="10"
                                     IsVisible="{Binding TotalItemCount, Converter={StaticResource NotEmptyConverter}}">

                    <BoxView Color="#1E1E1E" HeightRequest="1" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="SUBTOTAL" TextColor="#505050"
                               FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                               TextColor="White" FontSize="14" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto"
                          IsVisible="{Binding DiscountLabel, Converter={StaticResource NotEmptyConverter}}">
                        <Label Grid.Column="0" Text="{Binding DiscountLabel}"
                               TextColor="#505050" FontSize="10" FontAttributes="Bold"
                               CharacterSpacing="1" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Discount, StringFormat='-${0:F2}'}"
                               TextColor="#CCFF00" FontSize="14" VerticalOptions="Center" />
                    </Grid>

                    <!-- Envío -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="ENVÍO" TextColor="#505050"
                                   FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5" />
                            <Label Text="{Binding EnvioLabel}"
                                   TextColor="#CCFF00" FontSize="9" CharacterSpacing="0.5"
                                   IsVisible="{Binding EnvioGratis}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               IsVisible="{Binding EnvioGratis, Converter={StaticResource InvertBoolConverter}}"
                               Text="{Binding CostoEnvio, StringFormat='${0:F2}'}"
                               TextColor="White" FontSize="14" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               IsVisible="{Binding EnvioGratis}"
                               Text="GRATIS"
                               TextColor="#CCFF00" FontSize="12" FontAttributes="Bold"
                               CharacterSpacing="1" VerticalOptions="Center" />
                    </Grid>

                    <BoxView Color="#1E1E1E" HeightRequest="1" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="TOTAL"
                               TextColor="White" FontSize="12" FontAttributes="Bold"
                               CharacterSpacing="2" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Total, StringFormat='${0:F2}'}"
                               TextColor="#CCFF00" FontSize="26" FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Dirección de entrega -->
                    <Label Text="DIRECCIÓN DE ENTREGA" TextColor="#3A3A3A" FontSize="9"
                           FontAttributes="Bold" CharacterSpacing="2" Margin="0,8,0,2" />

                    <!-- Resumen dirección seleccionada (toca para cambiar) -->
                    <Border BackgroundColor="#141414"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="#1E1E1E"
                            Padding="14,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleAddressPickerCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding SelectedAddress.Name, TargetNullValue='Sin dirección seleccionada'}"
                                       TextColor="White" FontSize="12" FontAttributes="Bold" />
                                <Label Text="{Binding SelectedAddressLabel}"
                                       TextColor="#505050" FontSize="11" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="⌄" TextColor="#CCFF00" FontSize="20"
                                   VerticalOptions="Center" Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Lista de direcciones expandible (BindableLayout: sin scroll anidado) -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding UserAddresses}"
                                         IsVisible="{Binding ShowAddressPicker}"
                                         Spacing="4" Margin="0,4,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Address">
                                <Border StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1"
                                        Stroke="#252525"
                                        BackgroundColor="Transparent"
                                        Padding="12,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=SelectAddressCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding Name}"
                                                   TextColor="White" FontSize="12" FontAttributes="Bold" />
                                            <Label Text="{Binding Street}"
                                                   TextColor="#606060" FontSize="11" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="›" TextColor="#CCFF00"
                                               FontSize="18" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Sin direcciones: link a agregar -->
                    <Border BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="#252525"
                            Padding="0,10"
                            IsVisible="{Binding TieneAddresses, Converter={StaticResource InvertBoolConverter}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAddressesCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="+ Agregar dirección de entrega"
                               TextColor="#3A3A3A" FontSize="12"
                               HorizontalOptions="Center" />
                    </Border>

                    <!-- Promociones -->
                    <Border BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="#CCFF0033"
                            Padding="0,12"
                            Margin="0,4,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPromocionesCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label Text="🏷" FontSize="13" VerticalOptions="Center" />
                            <Label Text="VER PROMOCIONES DISPONIBLES"
                                   TextColor="#CCFF00"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>

        <!-- Botón fijo: continuar al pago -->
        <Border Grid.Row="2"
                BackgroundColor="#CCFF00"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                Margin="20,8,20,20"
                IsVisible="{Binding TotalItemCount, Converter={StaticResource NotEmptyConverter}}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ConfirmPurchaseCommand}" />
            </Border.GestureRecognizers>
            <Grid HeightRequest="56">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#0D0D0D"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                <VerticalStackLayout IsVisible="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="2">
                    <Label Text="CONTINUAR AL PAGO"
                           TextColor="#0D0D0D"
                           FontSize="14"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding Total, StringFormat='${0:F2}'}"
                           TextColor="#0D0D0D"
                           FontSize="11"
                           Opacity="0.6"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
