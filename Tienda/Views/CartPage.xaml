<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             xmlns:models="clr-namespace:Tienda.Models"
             x:DataType="vm:CartViewModel"
             x:Class="Tienda.Views.CartPage"
             BackgroundColor="#111111"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,16">
            <Label Grid.Column="0"
                   Text="CARRITO"
                   TextColor="White"
                   FontSize="22"
                   FontAttributes="Bold"
                   CharacterSpacing="2" />
            <Border Grid.Column="1"
                    BackgroundColor="#CCFF00"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    Padding="10,4">
                <Label Text="{Binding Items.Count, StringFormat='{0} items'}"
                       TextColor="#111111"
                       FontSize="11"
                       FontAttributes="Bold" />
            </Border>
        </Grid>

        <!-- Items list -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        Margin="0,0,0,8">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CartItem">
                    <Grid ColumnDefinitions="80, *, Auto"
                          Padding="16,14"
                          ColumnSpacing="14">
                        <Border Grid.Column="0"
                                BackgroundColor="#1E1E1E"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                HeightRequest="72"
                                WidthRequest="72">
                            <Image Source="{Binding Product.ImageUrl}" Aspect="AspectFill" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Product.Brand}"
                                   TextColor="#555555"
                                   FontSize="9"
                                   CharacterSpacing="2" />
                            <Label Text="{Binding Product.Name}"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Size, StringFormat='Talla {0}'}"
                                   TextColor="#666666"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                            <!-- Controles cantidad -->
                            <HorizontalStackLayout Spacing="12" Margin="0,8,0,0">
                                <Border BackgroundColor="#1E1E1E"
                                        StrokeShape="RoundRectangle 6"
                                        StrokeThickness="1"
                                        Stroke="#2E2E2E"
                                        WidthRequest="28"
                                        HeightRequest="28">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=DecreaseQuantityCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="−" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" />
                                </Border>
                                <Label Text="{Binding Quantity}"
                                       TextColor="White"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Border BackgroundColor="#1E1E1E"
                                        StrokeShape="RoundRectangle 6"
                                        StrokeThickness="1"
                                        Stroke="#2E2E2E"
                                        WidthRequest="28"
                                        HeightRequest="28">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=IncreaseQuantityCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="+" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="{Binding Product.Price, StringFormat='${0:F2}'}"
                               TextColor="#CCFF00"
                               FontSize="15"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Summary + Checkout -->
        <VerticalStackLayout Grid.Row="2" Padding="20,16" Spacing="8" BackgroundColor="#161616">

            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" Text="Subtotal" TextColor="#666666" FontSize="13" />
                <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:F2}'}" TextColor="White" FontSize="13" />
            </Grid>
            <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding DiscountLabel, Converter={StaticResource NotEmptyConverter}}">
                <Label Grid.Column="0" Text="{Binding DiscountLabel}" TextColor="#555555" FontSize="12" />
                <Label Grid.Column="1" Text="{Binding Discount, StringFormat='-${0:F2}'}" TextColor="#CCFF00" FontSize="12" />
            </Grid>
            <BoxView Color="#2E2E2E" HeightRequest="1" Margin="0,4" />
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" Text="Total" TextColor="White" FontSize="15" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="{Binding Total, StringFormat='${0:F2}'}" TextColor="#CCFF00" FontSize="22" FontAttributes="Bold" />
            </Grid>

            <!-- Pago -->
            <Label Text="MODALIDAD DE PAGO" TextColor="#555555" FontSize="10" CharacterSpacing="1.5" Margin="0,8,0,4" />
            <CollectionView ItemsSource="{Binding PaymentOptions}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedPayment}"
                            HeightRequest="44">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border BackgroundColor="#1E1E1E"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="1"
                                Stroke="#2E2E2E"
                                Padding="14,10">
                            <Label Text="{Binding .}" TextColor="#888888" FontSize="12" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border BackgroundColor="#CCFF00"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Padding="0,16"
                    Margin="0,8,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ConfirmPurchaseCommand}" />
                </Border.GestureRecognizers>
                <Label Text="CONFIRMAR COMPRA"
                       TextColor="#111111"
                       FontSize="14"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       HorizontalOptions="Center" />
            </Border>

        </VerticalStackLayout>
    </Grid>
</ContentPage>