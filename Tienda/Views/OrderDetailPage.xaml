<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tienda.ViewModels"
             x:DataType="vm:OrderDetailViewModel"
             x:Class="Tienda.Views.OrderDetailPage"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False"
             Title="Detalle Orden">

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,20,20,16" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
            <Border Grid.Column="0"
                    BackgroundColor="#141414"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    Stroke="#222222"
                    WidthRequest="40" HeightRequest="40">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Text="←" TextColor="White" FontSize="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label Text="{Binding OrdenLabel}"
                       TextColor="White" FontSize="18"
                       FontAttributes="Bold" CharacterSpacing="2" />
                <BoxView HeightRequest="2" WidthRequest="40" Color="#CCFF00" HorizontalOptions="Start" />
            </VerticalStackLayout>

            <!-- Estado badge -->
            <Border Grid.Column="2"
                    BackgroundColor="#111111"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1"
                    Stroke="#222222"
                    Padding="12,6"
                    VerticalOptions="Center">
                <Label Text="{Binding Estado}"
                       TextColor="{Binding EstadoColor}"
                       FontSize="9" FontAttributes="Bold" CharacterSpacing="1.5" />
            </Border>
        </Grid>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#CCFF00"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Error -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding HasError}"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             Spacing="12">
            <Label Text="—" TextColor="#FF3E00" FontSize="32"
                   FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="NO SE PUDO CARGAR LA ORDEN"
                   TextColor="#3A3A3A" FontSize="11"
                   FontAttributes="Bold" CharacterSpacing="2"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Contenido -->
        <ScrollView Grid.Row="1"
                    IsVisible="{Binding IsContentVisible}">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,32">

                <!-- Meta: fecha + modalidad -->
                <Grid ColumnDefinitions="*, *" Padding="20,0,20,20" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="FECHA" TextColor="#3A3A3A" FontSize="9"
                               FontAttributes="Bold" CharacterSpacing="2" />
                        <Label Text="{Binding Fecha}" TextColor="#808080" FontSize="12" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="PAGO" TextColor="#3A3A3A" FontSize="9"
                               FontAttributes="Bold" CharacterSpacing="2" />
                        <Label Text="{Binding Modalidad}"
                               TextColor="#CCFF00" FontSize="12" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Separador -->
                <BoxView Color="#161616" HeightRequest="1" Margin="20,0,20,20" />

                <!-- Título items -->
                <Label Text="PRODUCTOS"
                       TextColor="#3A3A3A" FontSize="9"
                       FontAttributes="Bold" CharacterSpacing="2.5"
                       Margin="20,0,20,12" />

                <!-- Lista de items -->
                <CollectionView ItemsSource="{Binding Items}"
                                Margin="20,0,20,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemDetalleVm">
                            <Border BackgroundColor="#111111"
                                    StrokeShape="RoundRectangle 0"
                                    StrokeThickness="0"
                                    Padding="16,14"
                                    Margin="0,0,0,2">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">

                                    <!-- Qty bubble -->
                                    <Border Grid.Column="0"
                                            BackgroundColor="#1C1C1C"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="1"
                                            Stroke="#252525"
                                            WidthRequest="36" HeightRequest="36">
                                        <Label Text="{Binding Cantidad}"
                                               TextColor="#CCFF00"
                                               FontSize="13" FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Nombre + precio unit -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Label Text="{Binding Nombre}"
                                               TextColor="White"
                                               FontSize="13" FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding PrecioUnit, StringFormat='${0:F2} c/u'}"
                                               TextColor="#404040" FontSize="11" />
                                    </VerticalStackLayout>

                                    <!-- Subtotal item -->
                                    <Label Grid.Column="2"
                                           Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                           TextColor="White"
                                           FontSize="14" FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Separador -->
                <BoxView Color="#161616" HeightRequest="1" Margin="20,20,20,20" />

                <!-- Totales -->
                <VerticalStackLayout Padding="20,0" Spacing="10">

                    <!-- Subtotal -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Subtotal"
                               TextColor="#606060" FontSize="13" />
                        <Label Grid.Column="1"
                               Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                               TextColor="#808080" FontSize="13" />
                    </Grid>

                    <!-- Descuento (si aplica) -->
                    <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding TieneDescuento}">
                        <Label Grid.Column="0" Text="Descuento"
                               TextColor="#606060" FontSize="13" />
                        <Label Grid.Column="1"
                               Text="{Binding Descuento, StringFormat='-${0:F2}'}"
                               TextColor="#CCFF00" FontSize="13" />
                    </Grid>

                    <!-- Divider -->
                    <BoxView Color="#1E1E1E" HeightRequest="1" />

                    <!-- Total -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="TOTAL"
                               TextColor="White" FontSize="16"
                               FontAttributes="Bold" CharacterSpacing="1" />
                        <Label Grid.Column="1"
                               Text="{Binding Total, StringFormat='${0:F2}'}"
                               TextColor="#CCFF00" FontSize="20"
                               FontAttributes="Bold" />
                    </Grid>

                </VerticalStackLayout>

                <!-- Botón rastreo -->
                <Border BackgroundColor="#111111"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        Stroke="#1E1E1E"
                        Padding="18,16"
                        Margin="20,20,20,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToTrackingCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                        <BoxView Grid.Column="0" Color="#CCFF00" WidthRequest="3" HeightRequest="24"
                                 VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="SEGUIMIENTO DE ENVÍO"
                                   TextColor="White" FontSize="13"
                                   FontAttributes="Bold" CharacterSpacing="0.5" />
                            <Label Text="Ver número de rastreo y estado"
                                   TextColor="#404040" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#404040" FontSize="22"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
