{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "Jwt": {
    "SecretKey": "T13nd4D3p4rtam3nt4l-S3cr3tK3y-2024!@#$",
    "Issuer": "ApiGateway.TiendaDepartamental",
    "Audience": "TiendaDepartamental.Clientes",
    "ExpiresInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Security": {
    "BlockedIps": []
  },
  "Microservices": {
    "Productos":   "http://ms-productos:8080",
    "Clientes":    "http://ms-clientes:8080",
    "Ordenes":     "http://ms-ordenes:8080",
    "Pagos":       "http://ms-pagos:8080",
    "Envios":      "http://ms-envios:8080",
    "Promociones": "http://ms-promociones:8080"
  },
  "ReverseProxy": {
    "Clusters": {
      "cluster-productos": {
        "Destinations": { "dest1": { "Address": "http://ms-productos:8080" } },
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } }
      },
      "cluster-clientes": {
        "Destinations": { "dest1": { "Address": "http://ms-clientes:8080" } },
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } }
      },
      "cluster-ordenes": {
        "Destinations": { "dest1": { "Address": "http://ms-ordenes:8080" } },
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } }
      },
      "cluster-pagos": {
        "Destinations": { "dest1": { "Address": "http://ms-pagos:8080" } },
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } }
      },
      "cluster-envios": {
        "Destinations": { "dest1": { "Address": "http://ms-envios:8080" } },
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } }
      },
      "cluster-promociones": {
        "Destinations": { "dest1": { "Address": "http://ms-promociones:8080" } },
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } }
      }
    },
    "Routes": {
      "route-productos-public": {
        "ClusterId": "cluster-productos",
        "Match": { "Path": "/api/productos/{**catch-all}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathPattern": "/api/productos/{**catch-all}" } ],
        "Metadata": { "RateLimiterPolicy": "public" }
      },
      "route-clientes-registro": {
        "ClusterId": "cluster-clientes",
        "Match": { "Path": "/api/clientes/registro", "Methods": [ "POST" ] },
        "Transforms": [ { "PathPattern": "/api/clientes/registro" } ],
        "Metadata": { "RateLimiterPolicy": "strict" }
      },
      "route-clientes-login": {
        "ClusterId": "cluster-clientes",
        "Match": { "Path": "/api/clientes/login", "Methods": [ "POST" ] },
        "Transforms": [ { "PathPattern": "/api/clientes/login" } ],
        "Metadata": { "RateLimiterPolicy": "strict" }
      },
      "route-clientes-auth": {
        "ClusterId": "cluster-clientes",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/clientes/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/clientes/{**catch-all}" } ],
        "Metadata": { "RateLimiterPolicy": "authenticated" }
      },
      "route-ordenes": {
        "ClusterId": "cluster-ordenes",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/ordenes/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/ordenes/{**catch-all}" } ],
        "Metadata": { "RateLimiterPolicy": "authenticated" }
      },
      "route-pagos": {
        "ClusterId": "cluster-pagos",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/pagos/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/pagos/{**catch-all}" } ],
        "Metadata": { "RateLimiterPolicy": "strict" }
      },
      "route-envios": {
        "ClusterId": "cluster-envios",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/envios/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/envios/{**catch-all}" } ],
        "Metadata": { "RateLimiterPolicy": "authenticated" }
      },
      "route-promociones-calcular": {
        "ClusterId": "cluster-promociones",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/promociones/calcular", "Methods": [ "POST" ] },
        "Transforms": [ { "PathPattern": "/api/promociones/calcular" } ],
        "Metadata": { "RateLimiterPolicy": "authenticated" }
      },
      "route-promociones-public": {
        "ClusterId": "cluster-promociones",
        "Match": { "Path": "/api/promociones/{**catch-all}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathPattern": "/api/promociones/{**catch-all}" } ],
        "Metadata": { "RateLimiterPolicy": "public" }
      },
      "route-promociones-admin": {
        "ClusterId": "cluster-promociones",
        "AuthorizationPolicy": "AdminOnly",
        "Match": { "Path": "/api/promociones/{**catch-all}", "Methods": [ "POST", "PUT", "DELETE", "PATCH" ] },
        "Transforms": [ { "PathPattern": "/api/promociones/{**catch-all}" } ],
        "Metadata": { "RateLimiterPolicy": "authenticated" }
      }
    }
  }
}
